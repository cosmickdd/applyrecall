# ApplyRecall Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# App Environment: "development" or "production"
APP_ENV=development

# Server
PORT=8000
HOST=0.0.0.0

# Database Configuration (Three Distinct PostgreSQL Roles)
# 1. Migration / DDL Role (applyrecall_migrator / postgres)
# Used exclusively by 'python -m app.cli migrate' or Render preDeployCommand release phase.
MIGRATION_DATABASE_URL=postgresql://applyrecall_migrator:your_migrator_password@db.example.com:5432/postgres

# 2. Application Runtime Role (applyrecall_app)
# Used by FastAPI backend and Telegram webhook router. Non-superuser, non-bypassrls, enforced by RLS.
DATABASE_URL=postgresql://applyrecall_app:your_app_password@db.example.com:5432/postgres

# 3. Worker Runtime Role (applyrecall_worker)
# Used by background reminder worker. Least-privilege role: column-level SELECT on applications,
# outcome UPDATE on reminders, SELECT on telegram_connections. NO ACCESS to profiles or answers.
WORKER_DATABASE_URL=postgresql://applyrecall_worker:your_worker_password@db.example.com:5432/postgres

# Test Database URL (Used by pytest integration test suite)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres

# Supabase Authentication (required for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# Worker Configuration
WORKER_BATCH_SIZE=10
WORKER_LEASE_MINUTES=5
WORKER_POLL_INTERVAL=30

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
