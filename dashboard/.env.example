# ApplyRecall Dashboard Environment Configuration
# Copy to .env.local for local development.

# Backend API proxy URL (used by Next.js rewrites)
BACKEND_PROXY_URL=http://127.0.0.1:8000

# Client-side API URL (leave blank to use the /api rewrite proxy)
NEXT_PUBLIC_API_URL=

# Supabase Auth Configuration (for production deployment)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
